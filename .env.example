ENVIRONMENT=development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

DATABASE_URL=postgresql://sova:password@localhost:5432/sova
REDIS_URL=redis://localhost:6379/0
# Отдельная логическая Redis DB для WebSocket channel layer (не cache и не Celery).
CHANNEL_REDIS_URL=redis://localhost:6379/2
REALTIME_MAX_CONNECTION_AGE_SECONDS=1800
REALTIME_CHANNEL_CAPACITY=100

# Gotenberg из sova-infra/compose.local.yml
GOTENBERG_URL=http://localhost:3001
GOTENBERG_TIMEOUT=30
# RabbitMQ is the production broker. Redis remains supported for local migration/testing.
CELERY_BROKER_URL=amqp://sova:password@localhost:5672//
INTEGRATION_LMS_URL=
INTEGRATION_LMS_INBOUND_TOKEN=
INTEGRATION_LMS_OUTBOUND_TOKEN=
INTEGRATION_CMS_URL=
INTEGRATION_CMS_INBOUND_TOKEN=
INTEGRATION_CMS_OUTBOUND_TOKEN=
INTEGRATION_HTTP_TIMEOUT=10
INTEGRATION_MAX_ATTEMPTS=5
INTEGRATION_MAX_PAYLOAD_BYTES=1048576
REPORTS_STORAGE_ROOT=./private/reports

# Пути внутри production-образа. Локально оставьте их закомментированными:
# Django возьмёт BASE_DIR/staticfiles и BASE_DIR/media.
# STATIC_ROOT=/app/staticfiles
# MEDIA_ROOT=/app/media

# Хранилище файлов (вложения, договоры, отчёты) — см. docs/plans/2026-09-23-s3-storage.md.
# filesystem (по умолчанию) — MEDIA_ROOT/REPORTS_STORAGE_ROOT, как сейчас; ничего ниже не нужно.
# s3 — Garage из sova-infra (локально: http://localhost:3900) или внешний S3-совместимый провайдер.
STORAGE_BACKEND=filesystem
# S3_DOWNLOAD_MODE=proxy: Django сам стримит файл (хранилище не публикуется наружу).
# S3_DOWNLOAD_MODE=redirect: 302 на подписанный URL — только если S3_ENDPOINT_URL виден браузеру.
# S3_DOWNLOAD_MODE=proxy
# S3_ENDPOINT_URL=http://localhost:3900
# S3_REGION=garage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_MEDIA_BUCKET=sova-media
# S3_REPORTS_BUCKET=sova-reports
# S3_ADDRESSING_STYLE=path
# S3_PRESIGNED_TTL=300
# FILE_UPLOAD_MAX_SIZE_MB=25

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL="СОВА <noreply@1uup.ru>"

# Шифрование персональных данных обучающихся. Обязательно вне development.
# Ключи Fernet через запятую: первый шифрует, остальные только читают (ротация — manage.py rotate_pd_keys).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PD_ENCRYPTION_KEYS=
# Ключ HMAC-индексов для поиска по email, телефону и СНИЛС. После смены индексы нужно пересчитать.
PD_HASH_KEY=

# Исходящие уведомления через Telegram Bot API.
# Токен создаётся через @BotFather; Telegram chat ID задаётся отдельно
# для каждого пользователя в его профиле уведомлений.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — используется для ссылки привязки https://t.me/<имя>?start=<токен>
TELEGRAM_BOT_USERNAME=
# Необязательный отдельный прокси для Telegram:
# http://user:password@proxy.example:3128 или socks5h://127.0.0.1:1080
TELEGRAM_PROXY=
NOTIFICATION_HTTP_TIMEOUT=10
# Срок жизни одноразовой ссылки привязки Telegram, минут
TELEGRAM_LINK_TOKEN_TTL_MINUTES=30

# Час ежедневной рассылки уведомлений о сроках, Europe/Moscow
OVERDUE_NOTIFY_HOUR=9

# Срок хранения уведомлений в системе, дней
NOTIFICATIONS_RETENTION_DAYS=60

# Keycloak / OpenID Connect
# Публичный адрес фронта: https://sova.1uup.ru (прод), https://dev.sova.1uup.ru (дев).
# Также используется для ссылок в уведомлениях email, Telegram и MAX.
APP_PUBLIC_URL=http://localhost:3000
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=sova
KEYCLOAK_CLIENT_ID=sova-web
KEYCLOAK_CLIENT_SECRET=
SESSION_COOKIE_AGE=28800
